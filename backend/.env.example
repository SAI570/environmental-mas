# Environment Configuration for Backend
# Default is SQLite for zero-config local operation
DATABASE_URL=sqlite:///./environmental_mas.db

# Optional remote database for future deployment (Supabase / PostgreSQL)
# Example: postgresql://postgres:your_password@db.your-supabase-project.supabase.co:5432/postgres

# Simulation settings
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
